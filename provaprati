create table jogadores (
    id_jogador serial primary key,
    nickname varchar(50) not null unique,
    email varchar(100) not null unique,
    senha varchar(100) not null,
    status varchar(20) not null default 'ativo',
    data_cadastro timestamp default current_timestamp,
    check (status in ('ativo', 'inativo', 'banido'))
)

 create table modalidades (
    id_modalidade serial primary key,
    nome varchar(100) not null unique,
    genero varchar(100),
    qtd_jogadores_equipe int not null,
    constraint quantidade_jogadores
    check (qtd_jogadores_equipe > 0)
 )  


create table torneios (
    id_torneio serial primary key,
    nome varchar(100) not null,
    descricao text,
    data_inicio date not null,
    data_fim date not null,
    check (data_fim >= data_inicio)
)
create table inscricoes (
    id_inscricao serial primary key,
    id_jogador int not null,
    id_torneio int not null,
    data_inscricao timestamp default current_timestamp,

    foreign key (id_jogador) references jogadores(id_jogador),
    foreign key (id_torneio) references torneios(id_torneio),

    unique (id_jogador, id_torneio)
)

create table partidas (
    id_partida serial primary key,
    titulo varchar(100) not null,
    id_modalidade int not null,
    id_jogador int not null,
    id_torneio int not null,
    data_agendamento timestamp not null,
    data_criacao timestamp,
    status varchar(20) not null default 'agendada',

    foreign key (id_modalidade) references modalidades(id_modalidade),
    foreign key (id_jogador) references jogadores(id_jogador),
    foreign key (id_torneio) references torneios(id_torneio),

    check (status in ('agendada', 'em andamento', 'finalizada', 'cancelada'))
)

create table historico_partidas (
    id_historico serial primary key,
    id_partida int not null,
    descricao text not null,
    data_registro timestamp default current_timestamp,

    foreign key (id_partida) references partidas(id_partida)
)

