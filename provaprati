create or replace view vw_painel_principal as
select
    j.nickname,
    p.titulo as titulo_partida,
    m.genero as categoria,
    p.data_agendamento as data_partida,
    p.status
from partidas p
inner join jogadores j
    on p.id_jogador = j.id_jogador
inner join modalidades m
    on p.id_modalidade = m.id_modalidade;



create or replace function fn_buscar_jogadores(termo text)
returns table (
    id_jogador int,
    nickname varchar(50),
    email varchar(100),
    status varchar(20)
)
as $$
begin

    return query
    select
        j.id_jogador,
        j.nickname,
        j.email,
        j.status
    from jogadores j
    where j.nickname ilike '%' || termo || '%'
       or j.email ilike '%' || termo || '%';

end;
$$ language plpgsql;




create or replace view vw_cronograma_partidas as
select
    p.id_partida,
    p.titulo,
    j.nickname,
    p.data_agendamento,
    p.status,
    (p.data_agendamento::date - current_date) as dias_restantes
from partidas p
inner join jogadores j
    on p.id_jogador = j.id_jogador
order by p.data_agendamento asc




