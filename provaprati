create or replace function fn_validar_partida()
returns trigger as $$
begin

    if not exists (
        select 1
        from jogadores
        where id_jogador = new.id_jogador
        and status = 'ativo'
    ) then
        raise exception 'o jogador não existe ou não está ativo.';
    end if;

    new.data_criacao := current_timestamp;

    return new;

end;
$$ language plpgsql;




create or replace function fn_registrar_historico()
returns trigger as $$
begin

    insert into historico_partidas (
        id_partida,
        descricao
    )
    values (
        new.id_partida,
        'nova partida cadastrada: ' || new.titulo
    );

    return new;

end;
$$ language plpgsql;




create trigger trg_validar_partida
before insert on partidas
for each row
execute function fn_validar_partida();


create trigger trg_historico_partida
after insert on partidas
for each row
execute function fn_registrar_historico();




